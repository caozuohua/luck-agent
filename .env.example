# ─── V2 Goal Runtime (.env) ──────────────────────────────────────
# 复制为 .env 后填写。未填 LLM_* 则回退到离线 FakeLLMClient。

# ─── LLM (OpenAI-compatible / new-api on VPS) ──────────────────
# VPS 上跑着 `new-api` 容器（calciumion/new-api），OpenAI 兼容。
# 公网域名或同机 localhost 均可；路径必须带 /v1。
# token 在 new-api 网页后台「用户 → 令牌」生成（不是 docker 的 ROOT_TOKEN）。
LLM_BASE_URL=https://api.caozuohua.cloud-ip.cc/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26b-a4b-it:free
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_FAILURE_THRESHOLD=3
LLM_COOLDOWN_SECONDS=30
# Ordered fallback providers. `primary` uses the legacy LLM_* variables above.
LLM_PROVIDER_ORDER=primary
LLM_QUOTA_COOLDOWN_SECONDS=3600
# Example backup provider (enable by adding `backup` to LLM_PROVIDER_ORDER):
# LLM_PROVIDER_BACKUP_BASE_URL=https://api.example.com/v1
# LLM_PROVIDER_BACKUP_API_KEY=
# LLM_PROVIDER_BACKUP_MODEL=
# LLM_PROVIDER_BACKUP_TIMEOUT_SECONDS=60
# LLM_PROVIDER_BACKUP_MAX_RETRIES=2
# LLM_PROVIDER_BACKUP_FAILURE_THRESHOLD=3
# LLM_PROVIDER_BACKUP_COOLDOWN_SECONDS=30
# LLM_PROVIDER_BACKUP_QUOTA_COOLDOWN_SECONDS=3600

# ─── Interface ───────────────────────────────────────────────────
# 不设 LARK_APP_ID/SECRET → V2 自动起本地网页测试界面（见 WEB_*）。
# 设了 Lark 凭据 → 走 Lark WebSocket（生产）。
LARK_APP_ID=
LARK_APP_SECRET=
LARK_DOMAIN=https://open.larksuite.com
# 逗号分隔；至少配置一个用户或群聊。未命中白名单的消息不回复。
LARK_ALLOWED_USER_IDS=
LARK_ALLOWED_CHAT_IDS=
LARK_ALLOW_UNCONFIGURED=false
LARK_APPROVAL_TTL_SECONDS=300
# Optional target/service/operation allowlists; target allowlist also gates
# /targets and read-only /vps commands. Empty values preserve current behavior.
# Optional Lark users allowed to use the VPS/service operation plane.
# Use comma-separated Lark open_id values; empty preserves current behavior.
OPS_ALLOWED_USER_IDS=
OPS_ALLOWED_TARGETS=
OPS_ALLOWED_SERVICES=
OPS_ALLOWED_OPERATIONS=
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ─── 可选 ──────────────────────────────────────────────────────
SERPER_API_KEY=            # web_search 工具用（无则降级 DuckDuckGo）
AGENT_WORKDIR=/opt/luck-agent/workspace
DB_PATH=/opt/luck-agent/data/agent.db
HEALTH_PORT=8080
VPS_NAME=                 # 可选；留空自动使用系统主机名
VPS_PROVIDER=aws
VPS_ACCOUNT=
VPS_REGION=
VPS_TARGET_ID=
VPS_ROLE=personal
# Optional catalog: id|provider|account|region|role|ssh_host|ssh_user|ssh_port|sysops_root;...
VPS_TARGETS=
VPS_SYSOPS_ROOT=/opt/vps_sysops
VPS_SYSOPS_PROFILE=aws
# Optional SSH config/key for remote vps_sysops execution; keep private keys outside Git.
VPS_SYSOPS_SSH_CONFIG=
VPS_SYSOPS_SSH_IDENTITY_FILE=
VPS_SYSOPS_TIMEOUT_SECONDS=15
VPS_SYSOPS_MAX_OUTPUT_CHARS=5000
SHELL_TIMEOUT_SECONDS=15
SHELL_MAX_OUTPUT_CHARS=4000

# ─── Mem0（可选；未配置 MEM0_BASE_URL 时不启用快捷命令）────────
MEM0_BASE_URL=http://127.0.0.1:8888
MEM0_API_KEY=
MEM0_USER_ID=personal
MEM0_AGENT_ID=luck-agent
MEM0_TIMEOUT_SECONDS=10

# ─── Runtime maintenance ───────────────────────────────────────
CURATOR_TRIGGER_INTERVAL=50
CURATOR_PERIODIC_INTERVAL_SECONDS=86400
SHUTDOWN_TIMEOUT_SECONDS=30

# ─── LangGraph ReAct 引擎（生产级可控资源上限）─────────────────
# EXECUTION_MODE: graph = LangGraph 多步 ReAct 循环（默认）; legacy = 旧单步
EXECUTION_MODE=graph
MAX_STEPS=12               # 每个目标的 ReAct 循环硬上限（防无限循环）
MAX_RETRY=2               # 单步重试预算（Supervisor）
GRAPH_DB_PATH=/opt/luck-agent/data/graph_state.db   # checkpointer（持久化/可恢复）
GRAPH_MAX_ACTIVE=1        # 每用户并发图数量上限（资源控制）
