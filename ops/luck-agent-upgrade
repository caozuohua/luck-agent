#!/bin/sh
set -eu

[ "$#" -eq 0 ] || exit 2
repo="/opt/luck-agent"
remote=$(/usr/sbin/runuser -u luck-agent -- /usr/bin/git -C "$repo" config --get remote.origin.url)
case "$remote" in
    *github.com/caozuohua/luck-agent.git|*github.com/caozuohua/luck-agent) ;;
    *) echo "unexpected origin: $remote" >&2; exit 3 ;;
esac

/usr/sbin/runuser -u luck-agent -- /usr/bin/git -C "$repo" diff --quiet
/usr/sbin/runuser -u luck-agent -- /usr/bin/git -C "$repo" diff --cached --quiet
/usr/sbin/runuser -u luck-agent -- /usr/bin/git -C "$repo" fetch origin
branch=$(/usr/sbin/runuser -u luck-agent -- /usr/bin/git -C "$repo" symbolic-ref --short HEAD)
/usr/sbin/runuser -u luck-agent -- /usr/bin/git -C "$repo" merge --ff-only "origin/$branch"
/usr/sbin/runuser -u luck-agent -- /opt/luck-agent/venv/bin/python -m compileall -q \
    "$repo/core" "$repo/interface" "$repo/memory" "$repo/runtime" "$repo/main.py"
/bin/systemctl daemon-reload
/bin/systemctl restart luck-agent
/usr/bin/git -C "$repo" rev-parse --short HEAD
